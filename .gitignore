# ── Credentials & secrets ─────────────────────────────────────────
hf_credential
*.token
.env
.env.*
!*.example

# ── Workspace (datasets, model weights) ──────────────────────────
# 产物/权重默认全部忽略, 但代码脚本类文件纳入版本控制
workspace/*
!workspace/*.py
!workspace/*.sh
!workspace/*.bat
!workspace/*.cmd
!workspace/*.ps1
!workspace/*.txt
!workspace/*.md
# psd_studio 只保留最新快照目录（含 CHANGELOG.md）
!workspace/psd_studio*/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# ── IDE & editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Misc artifacts ────────────────────────────────────────────────
tmp/
*.log
wandb/
local_*

# ── 本地临时补丁 / 基线 / 导出产物 ──────────────────────────────
_BASE_HASHES.json
_CHANGES.patch
fix.py
seethrough_*.patch
seethrough_*.zip
target/

# ── Symlink (user creates locally: ln -sf common/assets assets) ──
/assets
# end of file
